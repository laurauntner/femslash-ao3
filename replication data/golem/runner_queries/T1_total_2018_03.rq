# T1_total_2018_03: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2018-03-01" "2018-03-02" "2018-03-03" "2018-03-04" "2018-03-05" "2018-03-06" "2018-03-07" "2018-03-08" "2018-03-09" "2018-03-10" "2018-03-11" "2018-03-12" "2018-03-13" "2018-03-14" "2018-03-15" "2018-03-16" "2018-03-17" "2018-03-18" "2018-03-19" "2018-03-20" "2018-03-21" "2018-03-22" "2018-03-23" "2018-03-24" "2018-03-25" "2018-03-26" "2018-03-27" "2018-03-28" "2018-03-29" "2018-03-30" "2018-03-31" }
  ?s golem:datePublished ?d .
}