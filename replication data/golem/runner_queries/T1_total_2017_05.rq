# T1_total_2017_05: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2017-05-01" "2017-05-02" "2017-05-03" "2017-05-04" "2017-05-05" "2017-05-06" "2017-05-07" "2017-05-08" "2017-05-09" "2017-05-10" "2017-05-11" "2017-05-12" "2017-05-13" "2017-05-14" "2017-05-15" "2017-05-16" "2017-05-17" "2017-05-18" "2017-05-19" "2017-05-20" "2017-05-21" "2017-05-22" "2017-05-23" "2017-05-24" "2017-05-25" "2017-05-26" "2017-05-27" "2017-05-28" "2017-05-29" "2017-05-30" "2017-05-31" }
  ?s golem:datePublished ?d .
}