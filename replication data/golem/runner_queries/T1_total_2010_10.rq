# T1_total_2010_10: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2010-10-01" "2010-10-02" "2010-10-03" "2010-10-04" "2010-10-05" "2010-10-06" "2010-10-07" "2010-10-08" "2010-10-09" "2010-10-10" "2010-10-11" "2010-10-12" "2010-10-13" "2010-10-14" "2010-10-15" "2010-10-16" "2010-10-17" "2010-10-18" "2010-10-19" "2010-10-20" "2010-10-21" "2010-10-22" "2010-10-23" "2010-10-24" "2010-10-25" "2010-10-26" "2010-10-27" "2010-10-28" "2010-10-29" "2010-10-30" "2010-10-31" }
  ?s golem:datePublished ?d .
}