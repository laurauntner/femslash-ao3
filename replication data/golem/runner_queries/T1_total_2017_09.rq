# T1_total_2017_09: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2017-09-01" "2017-09-02" "2017-09-03" "2017-09-04" "2017-09-05" "2017-09-06" "2017-09-07" "2017-09-08" "2017-09-09" "2017-09-10" "2017-09-11" "2017-09-12" "2017-09-13" "2017-09-14" "2017-09-15" "2017-09-16" "2017-09-17" "2017-09-18" "2017-09-19" "2017-09-20" "2017-09-21" "2017-09-22" "2017-09-23" "2017-09-24" "2017-09-25" "2017-09-26" "2017-09-27" "2017-09-28" "2017-09-29" "2017-09-30" }
  ?s golem:datePublished ?d .
}