# T1_total_2013_12: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2013-12-01" "2013-12-02" "2013-12-03" "2013-12-04" "2013-12-05" "2013-12-06" "2013-12-07" "2013-12-08" "2013-12-09" "2013-12-10" "2013-12-11" "2013-12-12" "2013-12-13" "2013-12-14" "2013-12-15" "2013-12-16" "2013-12-17" "2013-12-18" "2013-12-19" "2013-12-20" "2013-12-21" "2013-12-22" "2013-12-23" "2013-12-24" "2013-12-25" "2013-12-26" "2013-12-27" "2013-12-28" "2013-12-29" "2013-12-30" "2013-12-31" }
  ?s golem:datePublished ?d .
}