# T1_total_2008_05: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2008-05-01" "2008-05-02" "2008-05-03" "2008-05-04" "2008-05-05" "2008-05-06" "2008-05-07" "2008-05-08" "2008-05-09" "2008-05-10" "2008-05-11" "2008-05-12" "2008-05-13" "2008-05-14" "2008-05-15" "2008-05-16" "2008-05-17" "2008-05-18" "2008-05-19" "2008-05-20" "2008-05-21" "2008-05-22" "2008-05-23" "2008-05-24" "2008-05-25" "2008-05-26" "2008-05-27" "2008-05-28" "2008-05-29" "2008-05-30" "2008-05-31" }
  ?s golem:datePublished ?d .
}