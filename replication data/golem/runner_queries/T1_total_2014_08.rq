# T1_total_2014_08: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2014-08-01" "2014-08-02" "2014-08-03" "2014-08-04" "2014-08-05" "2014-08-06" "2014-08-07" "2014-08-08" "2014-08-09" "2014-08-10" "2014-08-11" "2014-08-12" "2014-08-13" "2014-08-14" "2014-08-15" "2014-08-16" "2014-08-17" "2014-08-18" "2014-08-19" "2014-08-20" "2014-08-21" "2014-08-22" "2014-08-23" "2014-08-24" "2014-08-25" "2014-08-26" "2014-08-27" "2014-08-28" "2014-08-29" "2014-08-30" "2014-08-31" }
  ?s golem:datePublished ?d .
}