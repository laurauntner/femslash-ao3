# T4_topfandoms_sapphic_2021: top 40 fandoms of this family in this year.
# Purpose: which fandoms use the family (RQ2). Used in: Fig. 9.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT ?x (COUNT(DISTINCT ?s) AS ?n) WHERE {
  ?s golem:romanticCategory "F/F" ; golem:datePublished ?d .
  FILTER(STRSTARTS(STR(?d), "2021"))
  ?s golem:keyword ?kw .
  BIND(LCASE(STR(?kw)) AS ?k)
  FILTER(CONTAINS(?k, "sapphic"))
  ?s golem:fandom ?x .
}
GROUP BY ?x ORDER BY DESC(?n) LIMIT 40