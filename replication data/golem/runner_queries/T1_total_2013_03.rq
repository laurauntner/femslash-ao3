# T1_total_2013_03: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2013-03-01" "2013-03-02" "2013-03-03" "2013-03-04" "2013-03-05" "2013-03-06" "2013-03-07" "2013-03-08" "2013-03-09" "2013-03-10" "2013-03-11" "2013-03-12" "2013-03-13" "2013-03-14" "2013-03-15" "2013-03-16" "2013-03-17" "2013-03-18" "2013-03-19" "2013-03-20" "2013-03-21" "2013-03-22" "2013-03-23" "2013-03-24" "2013-03-25" "2013-03-26" "2013-03-27" "2013-03-28" "2013-03-29" "2013-03-30" "2013-03-31" }
  ?s golem:datePublished ?d .
}