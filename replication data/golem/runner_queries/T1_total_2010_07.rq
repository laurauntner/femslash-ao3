# T1_total_2010_07: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2010-07-01" "2010-07-02" "2010-07-03" "2010-07-04" "2010-07-05" "2010-07-06" "2010-07-07" "2010-07-08" "2010-07-09" "2010-07-10" "2010-07-11" "2010-07-12" "2010-07-13" "2010-07-14" "2010-07-15" "2010-07-16" "2010-07-17" "2010-07-18" "2010-07-19" "2010-07-20" "2010-07-21" "2010-07-22" "2010-07-23" "2010-07-24" "2010-07-25" "2010-07-26" "2010-07-27" "2010-07-28" "2010-07-29" "2010-07-30" "2010-07-31" }
  ?s golem:datePublished ?d .
}