# T1_total_2009_06: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2009-06-01" "2009-06-02" "2009-06-03" "2009-06-04" "2009-06-05" "2009-06-06" "2009-06-07" "2009-06-08" "2009-06-09" "2009-06-10" "2009-06-11" "2009-06-12" "2009-06-13" "2009-06-14" "2009-06-15" "2009-06-16" "2009-06-17" "2009-06-18" "2009-06-19" "2009-06-20" "2009-06-21" "2009-06-22" "2009-06-23" "2009-06-24" "2009-06-25" "2009-06-26" "2009-06-27" "2009-06-28" "2009-06-29" "2009-06-30" }
  ?s golem:datePublished ?d .
}