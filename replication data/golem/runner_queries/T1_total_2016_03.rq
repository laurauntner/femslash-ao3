# T1_total_2016_03: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2016-03-01" "2016-03-02" "2016-03-03" "2016-03-04" "2016-03-05" "2016-03-06" "2016-03-07" "2016-03-08" "2016-03-09" "2016-03-10" "2016-03-11" "2016-03-12" "2016-03-13" "2016-03-14" "2016-03-15" "2016-03-16" "2016-03-17" "2016-03-18" "2016-03-19" "2016-03-20" "2016-03-21" "2016-03-22" "2016-03-23" "2016-03-24" "2016-03-25" "2016-03-26" "2016-03-27" "2016-03-28" "2016-03-29" "2016-03-30" "2016-03-31" }
  ?s golem:datePublished ?d .
}