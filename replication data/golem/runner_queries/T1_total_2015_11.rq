# T1_total_2015_11: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2015-11-01" "2015-11-02" "2015-11-03" "2015-11-04" "2015-11-05" "2015-11-06" "2015-11-07" "2015-11-08" "2015-11-09" "2015-11-10" "2015-11-11" "2015-11-12" "2015-11-13" "2015-11-14" "2015-11-15" "2015-11-16" "2015-11-17" "2015-11-18" "2015-11-19" "2015-11-20" "2015-11-21" "2015-11-22" "2015-11-23" "2015-11-24" "2015-11-25" "2015-11-26" "2015-11-27" "2015-11-28" "2015-11-29" "2015-11-30" }
  ?s golem:datePublished ?d .
}