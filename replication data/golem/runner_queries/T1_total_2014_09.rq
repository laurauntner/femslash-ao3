# T1_total_2014_09: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2014-09-01" "2014-09-02" "2014-09-03" "2014-09-04" "2014-09-05" "2014-09-06" "2014-09-07" "2014-09-08" "2014-09-09" "2014-09-10" "2014-09-11" "2014-09-12" "2014-09-13" "2014-09-14" "2014-09-15" "2014-09-16" "2014-09-17" "2014-09-18" "2014-09-19" "2014-09-20" "2014-09-21" "2014-09-22" "2014-09-23" "2014-09-24" "2014-09-25" "2014-09-26" "2014-09-27" "2014-09-28" "2014-09-29" "2014-09-30" }
  ?s golem:datePublished ?d .
}