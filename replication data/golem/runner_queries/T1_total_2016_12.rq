# T1_total_2016_12: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2016-12-01" "2016-12-02" "2016-12-03" "2016-12-04" "2016-12-05" "2016-12-06" "2016-12-07" "2016-12-08" "2016-12-09" "2016-12-10" "2016-12-11" "2016-12-12" "2016-12-13" "2016-12-14" "2016-12-15" "2016-12-16" "2016-12-17" "2016-12-18" "2016-12-19" "2016-12-20" "2016-12-21" "2016-12-22" "2016-12-23" "2016-12-24" "2016-12-25" "2016-12-26" "2016-12-27" "2016-12-28" "2016-12-29" "2016-12-30" "2016-12-31" }
  ?s golem:datePublished ?d .
}