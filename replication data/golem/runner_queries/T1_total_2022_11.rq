# T1_total_2022_11: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2022-11-01" "2022-11-02" "2022-11-03" "2022-11-04" "2022-11-05" "2022-11-06" "2022-11-07" "2022-11-08" "2022-11-09" "2022-11-10" "2022-11-11" "2022-11-12" "2022-11-13" "2022-11-14" "2022-11-15" "2022-11-16" "2022-11-17" "2022-11-18" "2022-11-19" "2022-11-20" "2022-11-21" "2022-11-22" "2022-11-23" "2022-11-24" "2022-11-25" "2022-11-26" "2022-11-27" "2022-11-28" "2022-11-29" "2022-11-30" }
  ?s golem:datePublished ?d .
}