# T1_total_2016_05: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2016-05-01" "2016-05-02" "2016-05-03" "2016-05-04" "2016-05-05" "2016-05-06" "2016-05-07" "2016-05-08" "2016-05-09" "2016-05-10" "2016-05-11" "2016-05-12" "2016-05-13" "2016-05-14" "2016-05-15" "2016-05-16" "2016-05-17" "2016-05-18" "2016-05-19" "2016-05-20" "2016-05-21" "2016-05-22" "2016-05-23" "2016-05-24" "2016-05-25" "2016-05-26" "2016-05-27" "2016-05-28" "2016-05-29" "2016-05-30" "2016-05-31" }
  ?s golem:datePublished ?d .
}