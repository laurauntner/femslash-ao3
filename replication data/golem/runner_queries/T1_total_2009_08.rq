# T1_total_2009_08: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2009-08-01" "2009-08-02" "2009-08-03" "2009-08-04" "2009-08-05" "2009-08-06" "2009-08-07" "2009-08-08" "2009-08-09" "2009-08-10" "2009-08-11" "2009-08-12" "2009-08-13" "2009-08-14" "2009-08-15" "2009-08-16" "2009-08-17" "2009-08-18" "2009-08-19" "2009-08-20" "2009-08-21" "2009-08-22" "2009-08-23" "2009-08-24" "2009-08-25" "2009-08-26" "2009-08-27" "2009-08-28" "2009-08-29" "2009-08-30" "2009-08-31" }
  ?s golem:datePublished ?d .
}