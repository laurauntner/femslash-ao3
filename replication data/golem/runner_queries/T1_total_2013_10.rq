# T1_total_2013_10: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2013-10-01" "2013-10-02" "2013-10-03" "2013-10-04" "2013-10-05" "2013-10-06" "2013-10-07" "2013-10-08" "2013-10-09" "2013-10-10" "2013-10-11" "2013-10-12" "2013-10-13" "2013-10-14" "2013-10-15" "2013-10-16" "2013-10-17" "2013-10-18" "2013-10-19" "2013-10-20" "2013-10-21" "2013-10-22" "2013-10-23" "2013-10-24" "2013-10-25" "2013-10-26" "2013-10-27" "2013-10-28" "2013-10-29" "2013-10-30" "2013-10-31" }
  ?s golem:datePublished ?d .
}