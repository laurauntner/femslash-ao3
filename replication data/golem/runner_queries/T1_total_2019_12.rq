# T1_total_2019_12: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2019-12-01" "2019-12-02" "2019-12-03" "2019-12-04" "2019-12-05" "2019-12-06" "2019-12-07" "2019-12-08" "2019-12-09" "2019-12-10" "2019-12-11" "2019-12-12" "2019-12-13" "2019-12-14" "2019-12-15" "2019-12-16" "2019-12-17" "2019-12-18" "2019-12-19" "2019-12-20" "2019-12-21" "2019-12-22" "2019-12-23" "2019-12-24" "2019-12-25" "2019-12-26" "2019-12-27" "2019-12-28" "2019-12-29" "2019-12-30" "2019-12-31" }
  ?s golem:datePublished ?d .
}