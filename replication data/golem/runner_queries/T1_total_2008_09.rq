# T1_total_2008_09: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2008-09-01" "2008-09-02" "2008-09-03" "2008-09-04" "2008-09-05" "2008-09-06" "2008-09-07" "2008-09-08" "2008-09-09" "2008-09-10" "2008-09-11" "2008-09-12" "2008-09-13" "2008-09-14" "2008-09-15" "2008-09-16" "2008-09-17" "2008-09-18" "2008-09-19" "2008-09-20" "2008-09-21" "2008-09-22" "2008-09-23" "2008-09-24" "2008-09-25" "2008-09-26" "2008-09-27" "2008-09-28" "2008-09-29" "2008-09-30" }
  ?s golem:datePublished ?d .
}