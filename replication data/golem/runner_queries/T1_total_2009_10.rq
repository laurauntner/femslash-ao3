# T1_total_2009_10: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2009-10-01" "2009-10-02" "2009-10-03" "2009-10-04" "2009-10-05" "2009-10-06" "2009-10-07" "2009-10-08" "2009-10-09" "2009-10-10" "2009-10-11" "2009-10-12" "2009-10-13" "2009-10-14" "2009-10-15" "2009-10-16" "2009-10-17" "2009-10-18" "2009-10-19" "2009-10-20" "2009-10-21" "2009-10-22" "2009-10-23" "2009-10-24" "2009-10-25" "2009-10-26" "2009-10-27" "2009-10-28" "2009-10-29" "2009-10-30" "2009-10-31" }
  ?s golem:datePublished ?d .
}