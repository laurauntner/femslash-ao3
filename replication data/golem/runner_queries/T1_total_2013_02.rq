# T1_total_2013_02: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2013-02-01" "2013-02-02" "2013-02-03" "2013-02-04" "2013-02-05" "2013-02-06" "2013-02-07" "2013-02-08" "2013-02-09" "2013-02-10" "2013-02-11" "2013-02-12" "2013-02-13" "2013-02-14" "2013-02-15" "2013-02-16" "2013-02-17" "2013-02-18" "2013-02-19" "2013-02-20" "2013-02-21" "2013-02-22" "2013-02-23" "2013-02-24" "2013-02-25" "2013-02-26" "2013-02-27" "2013-02-28" }
  ?s golem:datePublished ?d .
}