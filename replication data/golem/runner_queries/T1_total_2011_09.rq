# T1_total_2011_09: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2011-09-01" "2011-09-02" "2011-09-03" "2011-09-04" "2011-09-05" "2011-09-06" "2011-09-07" "2011-09-08" "2011-09-09" "2011-09-10" "2011-09-11" "2011-09-12" "2011-09-13" "2011-09-14" "2011-09-15" "2011-09-16" "2011-09-17" "2011-09-18" "2011-09-19" "2011-09-20" "2011-09-21" "2011-09-22" "2011-09-23" "2011-09-24" "2011-09-25" "2011-09-26" "2011-09-27" "2011-09-28" "2011-09-29" "2011-09-30" }
  ?s golem:datePublished ?d .
}