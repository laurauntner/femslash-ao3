# T4_topauthors_wlw_2021: top 25 (anonymised) authors of this family in this year.
# Purpose: concentration of a family in few authors (RQ2). Used in: concentration_2020_22.csv.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT ?x (COUNT(DISTINCT ?s) AS ?n) WHERE {
  ?s golem:romanticCategory "F/F" ; golem:datePublished ?d .
  FILTER(STRSTARTS(STR(?d), "2021"))
  ?s golem:keyword ?kw .
  BIND(LCASE(STR(?kw)) AS ?k)
  FILTER(REGEX(?k, "(^|[^a-z])wlw([^a-z]|$)") || CONTAINS(?k, "women loving women"))
  ?s golem:author ?x .
}
GROUP BY ?x ORDER BY DESC(?n) LIMIT 25