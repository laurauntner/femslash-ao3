# T1_total_2011_03: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2011-03-01" "2011-03-02" "2011-03-03" "2011-03-04" "2011-03-05" "2011-03-06" "2011-03-07" "2011-03-08" "2011-03-09" "2011-03-10" "2011-03-11" "2011-03-12" "2011-03-13" "2011-03-14" "2011-03-15" "2011-03-16" "2011-03-17" "2011-03-18" "2011-03-19" "2011-03-20" "2011-03-21" "2011-03-22" "2011-03-23" "2011-03-24" "2011-03-25" "2011-03-26" "2011-03-27" "2011-03-28" "2011-03-29" "2011-03-30" "2011-03-31" }
  ?s golem:datePublished ?d .
}