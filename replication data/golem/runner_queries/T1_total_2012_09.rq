# T1_total_2012_09: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2012-09-01" "2012-09-02" "2012-09-03" "2012-09-04" "2012-09-05" "2012-09-06" "2012-09-07" "2012-09-08" "2012-09-09" "2012-09-10" "2012-09-11" "2012-09-12" "2012-09-13" "2012-09-14" "2012-09-15" "2012-09-16" "2012-09-17" "2012-09-18" "2012-09-19" "2012-09-20" "2012-09-21" "2012-09-22" "2012-09-23" "2012-09-24" "2012-09-25" "2012-09-26" "2012-09-27" "2012-09-28" "2012-09-29" "2012-09-30" }
  ?s golem:datePublished ?d .
}