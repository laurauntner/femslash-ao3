# T1_total_2015_04: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2015-04-01" "2015-04-02" "2015-04-03" "2015-04-04" "2015-04-05" "2015-04-06" "2015-04-07" "2015-04-08" "2015-04-09" "2015-04-10" "2015-04-11" "2015-04-12" "2015-04-13" "2015-04-14" "2015-04-15" "2015-04-16" "2015-04-17" "2015-04-18" "2015-04-19" "2015-04-20" "2015-04-21" "2015-04-22" "2015-04-23" "2015-04-24" "2015-04-25" "2015-04-26" "2015-04-27" "2015-04-28" "2015-04-29" "2015-04-30" }
  ?s golem:datePublished ?d .
}