# T1_total_2008_08: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2008-08-01" "2008-08-02" "2008-08-03" "2008-08-04" "2008-08-05" "2008-08-06" "2008-08-07" "2008-08-08" "2008-08-09" "2008-08-10" "2008-08-11" "2008-08-12" "2008-08-13" "2008-08-14" "2008-08-15" "2008-08-16" "2008-08-17" "2008-08-18" "2008-08-19" "2008-08-20" "2008-08-21" "2008-08-22" "2008-08-23" "2008-08-24" "2008-08-25" "2008-08-26" "2008-08-27" "2008-08-28" "2008-08-29" "2008-08-30" "2008-08-31" }
  ?s golem:datePublished ?d .
}