# T1_total_2022_03: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2022-03-01" "2022-03-02" "2022-03-03" "2022-03-04" "2022-03-05" "2022-03-06" "2022-03-07" "2022-03-08" "2022-03-09" "2022-03-10" "2022-03-11" "2022-03-12" "2022-03-13" "2022-03-14" "2022-03-15" "2022-03-16" "2022-03-17" "2022-03-18" "2022-03-19" "2022-03-20" "2022-03-21" "2022-03-22" "2022-03-23" "2022-03-24" "2022-03-25" "2022-03-26" "2022-03-27" "2022-03-28" "2022-03-29" "2022-03-30" "2022-03-31" }
  ?s golem:datePublished ?d .
}