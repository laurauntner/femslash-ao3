# T1_total_2013_11: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2013-11-01" "2013-11-02" "2013-11-03" "2013-11-04" "2013-11-05" "2013-11-06" "2013-11-07" "2013-11-08" "2013-11-09" "2013-11-10" "2013-11-11" "2013-11-12" "2013-11-13" "2013-11-14" "2013-11-15" "2013-11-16" "2013-11-17" "2013-11-18" "2013-11-19" "2013-11-20" "2013-11-21" "2013-11-22" "2013-11-23" "2013-11-24" "2013-11-25" "2013-11-26" "2013-11-27" "2013-11-28" "2013-11-29" "2013-11-30" }
  ?s golem:datePublished ?d .
}