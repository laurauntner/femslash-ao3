# T1_total_2012_04: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2012-04-01" "2012-04-02" "2012-04-03" "2012-04-04" "2012-04-05" "2012-04-06" "2012-04-07" "2012-04-08" "2012-04-09" "2012-04-10" "2012-04-11" "2012-04-12" "2012-04-13" "2012-04-14" "2012-04-15" "2012-04-16" "2012-04-17" "2012-04-18" "2012-04-19" "2012-04-20" "2012-04-21" "2012-04-22" "2012-04-23" "2012-04-24" "2012-04-25" "2012-04-26" "2012-04-27" "2012-04-28" "2012-04-29" "2012-04-30" }
  ?s golem:datePublished ?d .
}