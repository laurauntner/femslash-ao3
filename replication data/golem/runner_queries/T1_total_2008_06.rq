# T1_total_2008_06: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2008-06-01" "2008-06-02" "2008-06-03" "2008-06-04" "2008-06-05" "2008-06-06" "2008-06-07" "2008-06-08" "2008-06-09" "2008-06-10" "2008-06-11" "2008-06-12" "2008-06-13" "2008-06-14" "2008-06-15" "2008-06-16" "2008-06-17" "2008-06-18" "2008-06-19" "2008-06-20" "2008-06-21" "2008-06-22" "2008-06-23" "2008-06-24" "2008-06-25" "2008-06-26" "2008-06-27" "2008-06-28" "2008-06-29" "2008-06-30" }
  ?s golem:datePublished ?d .
}