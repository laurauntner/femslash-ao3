# T1_total_2011_02: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2011-02-01" "2011-02-02" "2011-02-03" "2011-02-04" "2011-02-05" "2011-02-06" "2011-02-07" "2011-02-08" "2011-02-09" "2011-02-10" "2011-02-11" "2011-02-12" "2011-02-13" "2011-02-14" "2011-02-15" "2011-02-16" "2011-02-17" "2011-02-18" "2011-02-19" "2011-02-20" "2011-02-21" "2011-02-22" "2011-02-23" "2011-02-24" "2011-02-25" "2011-02-26" "2011-02-27" "2011-02-28" }
  ?s golem:datePublished ?d .
}