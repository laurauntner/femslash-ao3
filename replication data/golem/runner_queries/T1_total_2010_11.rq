# T1_total_2010_11: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2010-11-01" "2010-11-02" "2010-11-03" "2010-11-04" "2010-11-05" "2010-11-06" "2010-11-07" "2010-11-08" "2010-11-09" "2010-11-10" "2010-11-11" "2010-11-12" "2010-11-13" "2010-11-14" "2010-11-15" "2010-11-16" "2010-11-17" "2010-11-18" "2010-11-19" "2010-11-20" "2010-11-21" "2010-11-22" "2010-11-23" "2010-11-24" "2010-11-25" "2010-11-26" "2010-11-27" "2010-11-28" "2010-11-29" "2010-11-30" }
  ?s golem:datePublished ?d .
}