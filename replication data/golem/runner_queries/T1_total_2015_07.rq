# T1_total_2015_07: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2015-07-01" "2015-07-02" "2015-07-03" "2015-07-04" "2015-07-05" "2015-07-06" "2015-07-07" "2015-07-08" "2015-07-09" "2015-07-10" "2015-07-11" "2015-07-12" "2015-07-13" "2015-07-14" "2015-07-15" "2015-07-16" "2015-07-17" "2015-07-18" "2015-07-19" "2015-07-20" "2015-07-21" "2015-07-22" "2015-07-23" "2015-07-24" "2015-07-25" "2015-07-26" "2015-07-27" "2015-07-28" "2015-07-29" "2015-07-30" "2015-07-31" }
  ?s golem:datePublished ?d .
}