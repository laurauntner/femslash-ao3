# T1_total_2013_07: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2013-07-01" "2013-07-02" "2013-07-03" "2013-07-04" "2013-07-05" "2013-07-06" "2013-07-07" "2013-07-08" "2013-07-09" "2013-07-10" "2013-07-11" "2013-07-12" "2013-07-13" "2013-07-14" "2013-07-15" "2013-07-16" "2013-07-17" "2013-07-18" "2013-07-19" "2013-07-20" "2013-07-21" "2013-07-22" "2013-07-23" "2013-07-24" "2013-07-25" "2013-07-26" "2013-07-27" "2013-07-28" "2013-07-29" "2013-07-30" "2013-07-31" }
  ?s golem:datePublished ?d .
}