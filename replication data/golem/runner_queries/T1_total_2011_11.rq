# T1_total_2011_11: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2011-11-01" "2011-11-02" "2011-11-03" "2011-11-04" "2011-11-05" "2011-11-06" "2011-11-07" "2011-11-08" "2011-11-09" "2011-11-10" "2011-11-11" "2011-11-12" "2011-11-13" "2011-11-14" "2011-11-15" "2011-11-16" "2011-11-17" "2011-11-18" "2011-11-19" "2011-11-20" "2011-11-21" "2011-11-22" "2011-11-23" "2011-11-24" "2011-11-25" "2011-11-26" "2011-11-27" "2011-11-28" "2011-11-29" "2011-11-30" }
  ?s golem:datePublished ?d .
}