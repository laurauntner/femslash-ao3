# T1_total_2022_09: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2022-09-01" "2022-09-02" "2022-09-03" "2022-09-04" "2022-09-05" "2022-09-06" "2022-09-07" "2022-09-08" "2022-09-09" "2022-09-10" "2022-09-11" "2022-09-12" "2022-09-13" "2022-09-14" "2022-09-15" "2022-09-16" "2022-09-17" "2022-09-18" "2022-09-19" "2022-09-20" "2022-09-21" "2022-09-22" "2022-09-23" "2022-09-24" "2022-09-25" "2022-09-26" "2022-09-27" "2022-09-28" "2022-09-29" "2022-09-30" }
  ?s golem:datePublished ?d .
}