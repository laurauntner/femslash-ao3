# T1_total_2009_07: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2009-07-01" "2009-07-02" "2009-07-03" "2009-07-04" "2009-07-05" "2009-07-06" "2009-07-07" "2009-07-08" "2009-07-09" "2009-07-10" "2009-07-11" "2009-07-12" "2009-07-13" "2009-07-14" "2009-07-15" "2009-07-16" "2009-07-17" "2009-07-18" "2009-07-19" "2009-07-20" "2009-07-21" "2009-07-22" "2009-07-23" "2009-07-24" "2009-07-25" "2009-07-26" "2009-07-27" "2009-07-28" "2009-07-29" "2009-07-30" "2009-07-31" }
  ?s golem:datePublished ?d .
}