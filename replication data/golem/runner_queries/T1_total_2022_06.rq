# T1_total_2022_06: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2022-06-01" "2022-06-02" "2022-06-03" "2022-06-04" "2022-06-05" "2022-06-06" "2022-06-07" "2022-06-08" "2022-06-09" "2022-06-10" "2022-06-11" "2022-06-12" "2022-06-13" "2022-06-14" "2022-06-15" "2022-06-16" "2022-06-17" "2022-06-18" "2022-06-19" "2022-06-20" "2022-06-21" "2022-06-22" "2022-06-23" "2022-06-24" "2022-06-25" "2022-06-26" "2022-06-27" "2022-06-28" "2022-06-29" "2022-06-30" }
  ?s golem:datePublished ?d .
}