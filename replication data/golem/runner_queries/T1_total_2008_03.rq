# T1_total_2008_03: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2008-03-01" "2008-03-02" "2008-03-03" "2008-03-04" "2008-03-05" "2008-03-06" "2008-03-07" "2008-03-08" "2008-03-09" "2008-03-10" "2008-03-11" "2008-03-12" "2008-03-13" "2008-03-14" "2008-03-15" "2008-03-16" "2008-03-17" "2008-03-18" "2008-03-19" "2008-03-20" "2008-03-21" "2008-03-22" "2008-03-23" "2008-03-24" "2008-03-25" "2008-03-26" "2008-03-27" "2008-03-28" "2008-03-29" "2008-03-30" "2008-03-31" }
  ?s golem:datePublished ?d .
}