# T1_total_2008_07: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2008-07-01" "2008-07-02" "2008-07-03" "2008-07-04" "2008-07-05" "2008-07-06" "2008-07-07" "2008-07-08" "2008-07-09" "2008-07-10" "2008-07-11" "2008-07-12" "2008-07-13" "2008-07-14" "2008-07-15" "2008-07-16" "2008-07-17" "2008-07-18" "2008-07-19" "2008-07-20" "2008-07-21" "2008-07-22" "2008-07-23" "2008-07-24" "2008-07-25" "2008-07-26" "2008-07-27" "2008-07-28" "2008-07-29" "2008-07-30" "2008-07-31" }
  ?s golem:datePublished ?d .
}