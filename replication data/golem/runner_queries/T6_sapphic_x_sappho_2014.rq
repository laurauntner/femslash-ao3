# T6_sapphic_x_sappho_2014: 'sapphic' F/F works that also carry a Sappho tag, this year.
# Purpose: whether 'sapphic' refers to Sappho (RQ3). Used in: key_numbers_golem.csv.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?works) WHERE {
  ?s golem:romanticCategory "F/F" ; golem:datePublished ?d .
  FILTER(STRSTARTS(STR(?d), "2014"))
  ?s golem:keyword ?kw .
  BIND(LCASE(STR(?kw)) AS ?k)
  FILTER(CONTAINS(?k, "sapphic"))
