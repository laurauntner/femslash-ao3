# T1_total_2008_02: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2008-02-01" "2008-02-02" "2008-02-03" "2008-02-04" "2008-02-05" "2008-02-06" "2008-02-07" "2008-02-08" "2008-02-09" "2008-02-10" "2008-02-11" "2008-02-12" "2008-02-13" "2008-02-14" "2008-02-15" "2008-02-16" "2008-02-17" "2008-02-18" "2008-02-19" "2008-02-20" "2008-02-21" "2008-02-22" "2008-02-23" "2008-02-24" "2008-02-25" "2008-02-26" "2008-02-27" "2008-02-28" "2008-02-29" }
  ?s golem:datePublished ?d .
}