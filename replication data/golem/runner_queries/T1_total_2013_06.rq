# T1_total_2013_06: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2013-06-01" "2013-06-02" "2013-06-03" "2013-06-04" "2013-06-05" "2013-06-06" "2013-06-07" "2013-06-08" "2013-06-09" "2013-06-10" "2013-06-11" "2013-06-12" "2013-06-13" "2013-06-14" "2013-06-15" "2013-06-16" "2013-06-17" "2013-06-18" "2013-06-19" "2013-06-20" "2013-06-21" "2013-06-22" "2013-06-23" "2013-06-24" "2013-06-25" "2013-06-26" "2013-06-27" "2013-06-28" "2013-06-29" "2013-06-30" }
  ?s golem:datePublished ?d .
}