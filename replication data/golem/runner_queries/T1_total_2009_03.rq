# T1_total_2009_03: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2009-03-01" "2009-03-02" "2009-03-03" "2009-03-04" "2009-03-05" "2009-03-06" "2009-03-07" "2009-03-08" "2009-03-09" "2009-03-10" "2009-03-11" "2009-03-12" "2009-03-13" "2009-03-14" "2009-03-15" "2009-03-16" "2009-03-17" "2009-03-18" "2009-03-19" "2009-03-20" "2009-03-21" "2009-03-22" "2009-03-23" "2009-03-24" "2009-03-25" "2009-03-26" "2009-03-27" "2009-03-28" "2009-03-29" "2009-03-30" "2009-03-31" }
  ?s golem:datePublished ?d .
}