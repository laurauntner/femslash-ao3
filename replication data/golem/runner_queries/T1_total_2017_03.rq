# T1_total_2017_03: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2017-03-01" "2017-03-02" "2017-03-03" "2017-03-04" "2017-03-05" "2017-03-06" "2017-03-07" "2017-03-08" "2017-03-09" "2017-03-10" "2017-03-11" "2017-03-12" "2017-03-13" "2017-03-14" "2017-03-15" "2017-03-16" "2017-03-17" "2017-03-18" "2017-03-19" "2017-03-20" "2017-03-21" "2017-03-22" "2017-03-23" "2017-03-24" "2017-03-25" "2017-03-26" "2017-03-27" "2017-03-28" "2017-03-29" "2017-03-30" "2017-03-31" }
  ?s golem:datePublished ?d .
}