# T1_total_2010_03: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2010-03-01" "2010-03-02" "2010-03-03" "2010-03-04" "2010-03-05" "2010-03-06" "2010-03-07" "2010-03-08" "2010-03-09" "2010-03-10" "2010-03-11" "2010-03-12" "2010-03-13" "2010-03-14" "2010-03-15" "2010-03-16" "2010-03-17" "2010-03-18" "2010-03-19" "2010-03-20" "2010-03-21" "2010-03-22" "2010-03-23" "2010-03-24" "2010-03-25" "2010-03-26" "2010-03-27" "2010-03-28" "2010-03-29" "2010-03-30" "2010-03-31" }
  ?s golem:datePublished ?d .
}