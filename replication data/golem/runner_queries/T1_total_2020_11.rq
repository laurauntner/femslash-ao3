# T1_total_2020_11: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2020-11-01" "2020-11-02" "2020-11-03" "2020-11-04" "2020-11-05" "2020-11-06" "2020-11-07" "2020-11-08" "2020-11-09" "2020-11-10" "2020-11-11" "2020-11-12" "2020-11-13" "2020-11-14" "2020-11-15" "2020-11-16" "2020-11-17" "2020-11-18" "2020-11-19" "2020-11-20" "2020-11-21" "2020-11-22" "2020-11-23" "2020-11-24" "2020-11-25" "2020-11-26" "2020-11-27" "2020-11-28" "2020-11-29" "2020-11-30" }
  ?s golem:datePublished ?d .
}