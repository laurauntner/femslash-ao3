# T1_total_2022_05: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2022-05-01" "2022-05-02" "2022-05-03" "2022-05-04" "2022-05-05" "2022-05-06" "2022-05-07" "2022-05-08" "2022-05-09" "2022-05-10" "2022-05-11" "2022-05-12" "2022-05-13" "2022-05-14" "2022-05-15" "2022-05-16" "2022-05-17" "2022-05-18" "2022-05-19" "2022-05-20" "2022-05-21" "2022-05-22" "2022-05-23" "2022-05-24" "2022-05-25" "2022-05-26" "2022-05-27" "2022-05-28" "2022-05-29" "2022-05-30" "2022-05-31" }
  ?s golem:datePublished ?d .
}