# T1_total_2015_06: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2015-06-01" "2015-06-02" "2015-06-03" "2015-06-04" "2015-06-05" "2015-06-06" "2015-06-07" "2015-06-08" "2015-06-09" "2015-06-10" "2015-06-11" "2015-06-12" "2015-06-13" "2015-06-14" "2015-06-15" "2015-06-16" "2015-06-17" "2015-06-18" "2015-06-19" "2015-06-20" "2015-06-21" "2015-06-22" "2015-06-23" "2015-06-24" "2015-06-25" "2015-06-26" "2015-06-27" "2015-06-28" "2015-06-29" "2015-06-30" }
  ?s golem:datePublished ?d .
}