# T1_total_2019_08: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2019-08-01" "2019-08-02" "2019-08-03" "2019-08-04" "2019-08-05" "2019-08-06" "2019-08-07" "2019-08-08" "2019-08-09" "2019-08-10" "2019-08-11" "2019-08-12" "2019-08-13" "2019-08-14" "2019-08-15" "2019-08-16" "2019-08-17" "2019-08-18" "2019-08-19" "2019-08-20" "2019-08-21" "2019-08-22" "2019-08-23" "2019-08-24" "2019-08-25" "2019-08-26" "2019-08-27" "2019-08-28" "2019-08-29" "2019-08-30" "2019-08-31" }
  ?s golem:datePublished ?d .
}