# T1_total_2008_11: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2008-11-01" "2008-11-02" "2008-11-03" "2008-11-04" "2008-11-05" "2008-11-06" "2008-11-07" "2008-11-08" "2008-11-09" "2008-11-10" "2008-11-11" "2008-11-12" "2008-11-13" "2008-11-14" "2008-11-15" "2008-11-16" "2008-11-17" "2008-11-18" "2008-11-19" "2008-11-20" "2008-11-21" "2008-11-22" "2008-11-23" "2008-11-24" "2008-11-25" "2008-11-26" "2008-11-27" "2008-11-28" "2008-11-29" "2008-11-30" }
  ?s golem:datePublished ?d .
}