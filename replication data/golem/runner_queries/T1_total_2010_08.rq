# T1_total_2010_08: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2010-08-01" "2010-08-02" "2010-08-03" "2010-08-04" "2010-08-05" "2010-08-06" "2010-08-07" "2010-08-08" "2010-08-09" "2010-08-10" "2010-08-11" "2010-08-12" "2010-08-13" "2010-08-14" "2010-08-15" "2010-08-16" "2010-08-17" "2010-08-18" "2010-08-19" "2010-08-20" "2010-08-21" "2010-08-22" "2010-08-23" "2010-08-24" "2010-08-25" "2010-08-26" "2010-08-27" "2010-08-28" "2010-08-29" "2010-08-30" "2010-08-31" }
  ?s golem:datePublished ?d .
}