# T1_total_2020_09: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2020-09-01" "2020-09-02" "2020-09-03" "2020-09-04" "2020-09-05" "2020-09-06" "2020-09-07" "2020-09-08" "2020-09-09" "2020-09-10" "2020-09-11" "2020-09-12" "2020-09-13" "2020-09-14" "2020-09-15" "2020-09-16" "2020-09-17" "2020-09-18" "2020-09-19" "2020-09-20" "2020-09-21" "2020-09-22" "2020-09-23" "2020-09-24" "2020-09-25" "2020-09-26" "2020-09-27" "2020-09-28" "2020-09-29" "2020-09-30" }
  ?s golem:datePublished ?d .
}