# T1_total_2010_04: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2010-04-01" "2010-04-02" "2010-04-03" "2010-04-04" "2010-04-05" "2010-04-06" "2010-04-07" "2010-04-08" "2010-04-09" "2010-04-10" "2010-04-11" "2010-04-12" "2010-04-13" "2010-04-14" "2010-04-15" "2010-04-16" "2010-04-17" "2010-04-18" "2010-04-19" "2010-04-20" "2010-04-21" "2010-04-22" "2010-04-23" "2010-04-24" "2010-04-25" "2010-04-26" "2010-04-27" "2010-04-28" "2010-04-29" "2010-04-30" }
  ?s golem:datePublished ?d .
}