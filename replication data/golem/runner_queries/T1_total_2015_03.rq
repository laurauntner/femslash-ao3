# T1_total_2015_03: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2015-03-01" "2015-03-02" "2015-03-03" "2015-03-04" "2015-03-05" "2015-03-06" "2015-03-07" "2015-03-08" "2015-03-09" "2015-03-10" "2015-03-11" "2015-03-12" "2015-03-13" "2015-03-14" "2015-03-15" "2015-03-16" "2015-03-17" "2015-03-18" "2015-03-19" "2015-03-20" "2015-03-21" "2015-03-22" "2015-03-23" "2015-03-24" "2015-03-25" "2015-03-26" "2015-03-27" "2015-03-28" "2015-03-29" "2015-03-30" "2015-03-31" }
  ?s golem:datePublished ?d .
}