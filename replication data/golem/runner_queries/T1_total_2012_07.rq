# T1_total_2012_07: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2012-07-01" "2012-07-02" "2012-07-03" "2012-07-04" "2012-07-05" "2012-07-06" "2012-07-07" "2012-07-08" "2012-07-09" "2012-07-10" "2012-07-11" "2012-07-12" "2012-07-13" "2012-07-14" "2012-07-15" "2012-07-16" "2012-07-17" "2012-07-18" "2012-07-19" "2012-07-20" "2012-07-21" "2012-07-22" "2012-07-23" "2012-07-24" "2012-07-25" "2012-07-26" "2012-07-27" "2012-07-28" "2012-07-29" "2012-07-30" "2012-07-31" }
  ?s golem:datePublished ?d .
}