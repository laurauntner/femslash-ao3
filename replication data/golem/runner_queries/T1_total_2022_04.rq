# T1_total_2022_04: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2022-04-01" "2022-04-02" "2022-04-03" "2022-04-04" "2022-04-05" "2022-04-06" "2022-04-07" "2022-04-08" "2022-04-09" "2022-04-10" "2022-04-11" "2022-04-12" "2022-04-13" "2022-04-14" "2022-04-15" "2022-04-16" "2022-04-17" "2022-04-18" "2022-04-19" "2022-04-20" "2022-04-21" "2022-04-22" "2022-04-23" "2022-04-24" "2022-04-25" "2022-04-26" "2022-04-27" "2022-04-28" "2022-04-29" "2022-04-30" }
  ?s golem:datePublished ?d .
}