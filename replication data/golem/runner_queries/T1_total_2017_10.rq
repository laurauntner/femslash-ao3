# T1_total_2017_10: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2017-10-01" "2017-10-02" "2017-10-03" "2017-10-04" "2017-10-05" "2017-10-06" "2017-10-07" "2017-10-08" "2017-10-09" "2017-10-10" "2017-10-11" "2017-10-12" "2017-10-13" "2017-10-14" "2017-10-15" "2017-10-16" "2017-10-17" "2017-10-18" "2017-10-19" "2017-10-20" "2017-10-21" "2017-10-22" "2017-10-23" "2017-10-24" "2017-10-25" "2017-10-26" "2017-10-27" "2017-10-28" "2017-10-29" "2017-10-30" "2017-10-31" }
  ?s golem:datePublished ?d .
}