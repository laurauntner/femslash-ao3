# T1_total_2013_04: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2013-04-01" "2013-04-02" "2013-04-03" "2013-04-04" "2013-04-05" "2013-04-06" "2013-04-07" "2013-04-08" "2013-04-09" "2013-04-10" "2013-04-11" "2013-04-12" "2013-04-13" "2013-04-14" "2013-04-15" "2013-04-16" "2013-04-17" "2013-04-18" "2013-04-19" "2013-04-20" "2013-04-21" "2013-04-22" "2013-04-23" "2013-04-24" "2013-04-25" "2013-04-26" "2013-04-27" "2013-04-28" "2013-04-29" "2013-04-30" }
  ?s golem:datePublished ?d .
}