# T2_families_2015: F/F works per label family in this year (each tag assigned to one family).
# Purpose: change in labelling over time (RQ1). Used in: Figs. 3-4.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT ?fam (COUNT(DISTINCT ?s) AS ?works) WHERE {
  ?s golem:romanticCategory "F/F" ; golem:datePublished ?d .
  FILTER(STRSTARTS(STR(?d), "2015"))
  ?s golem:keyword ?kw .
  BIND(LCASE(STR(?kw)) AS ?k)
  BIND(IF(CONTAINS(?k, "femslash"), "femslash", IF(CONTAINS(?k, "sapphic"), "sapphic", IF(CONTAINS(?k, "lesbian"), "lesbian", IF(REGEX(?k, "(^|[^a-z])wlw([^a-z]|$)") || CONTAINS(?k, "women loving women"), "wlw", IF(?k IN ("yuri", "yuri - freeform", "shoujo ai", "shoujo-ai", "shojo ai", "shoujo ai - freeform"), "yuri", IF(CONTAINS(?k, "百合") || CONTAINS(?k, "baihe"), "baihe", "")))))) AS ?fam)
  FILTER(?fam != "")
}
GROUP BY ?fam