# q3d: Rating distribution for 'Sapphic'/'Sapphics'. Exploratory.
# Result: ../adhoc_results/q3d.csv
PREFIX golem: <https://golemlab.eu/graph/>
SELECT ?r (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?kw { "Sapphic" "Sapphics" }
  ?s golem:keyword ?kw ; golem:rating ?r .
}
GROUP BY ?r ORDER BY DESC(?n)
