# T1_total_2010_09: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2010-09-01" "2010-09-02" "2010-09-03" "2010-09-04" "2010-09-05" "2010-09-06" "2010-09-07" "2010-09-08" "2010-09-09" "2010-09-10" "2010-09-11" "2010-09-12" "2010-09-13" "2010-09-14" "2010-09-15" "2010-09-16" "2010-09-17" "2010-09-18" "2010-09-19" "2010-09-20" "2010-09-21" "2010-09-22" "2010-09-23" "2010-09-24" "2010-09-25" "2010-09-26" "2010-09-27" "2010-09-28" "2010-09-29" "2010-09-30" }
  ?s golem:datePublished ?d .
}