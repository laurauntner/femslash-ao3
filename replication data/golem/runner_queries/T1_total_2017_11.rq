# T1_total_2017_11: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2017-11-01" "2017-11-02" "2017-11-03" "2017-11-04" "2017-11-05" "2017-11-06" "2017-11-07" "2017-11-08" "2017-11-09" "2017-11-10" "2017-11-11" "2017-11-12" "2017-11-13" "2017-11-14" "2017-11-15" "2017-11-16" "2017-11-17" "2017-11-18" "2017-11-19" "2017-11-20" "2017-11-21" "2017-11-22" "2017-11-23" "2017-11-24" "2017-11-25" "2017-11-26" "2017-11-27" "2017-11-28" "2017-11-29" "2017-11-30" }
  ?s golem:datePublished ?d .
}