# T1_total_2015_08: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2015-08-01" "2015-08-02" "2015-08-03" "2015-08-04" "2015-08-05" "2015-08-06" "2015-08-07" "2015-08-08" "2015-08-09" "2015-08-10" "2015-08-11" "2015-08-12" "2015-08-13" "2015-08-14" "2015-08-15" "2015-08-16" "2015-08-17" "2015-08-18" "2015-08-19" "2015-08-20" "2015-08-21" "2015-08-22" "2015-08-23" "2015-08-24" "2015-08-25" "2015-08-26" "2015-08-27" "2015-08-28" "2015-08-29" "2015-08-30" "2015-08-31" }
  ?s golem:datePublished ?d .
}