# T1_total_2013_08: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2013-08-01" "2013-08-02" "2013-08-03" "2013-08-04" "2013-08-05" "2013-08-06" "2013-08-07" "2013-08-08" "2013-08-09" "2013-08-10" "2013-08-11" "2013-08-12" "2013-08-13" "2013-08-14" "2013-08-15" "2013-08-16" "2013-08-17" "2013-08-18" "2013-08-19" "2013-08-20" "2013-08-21" "2013-08-22" "2013-08-23" "2013-08-24" "2013-08-25" "2013-08-26" "2013-08-27" "2013-08-28" "2013-08-29" "2013-08-30" "2013-08-31" }
  ?s golem:datePublished ?d .
}