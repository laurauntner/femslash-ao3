# T1_total_2016_02: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2016-02-01" "2016-02-02" "2016-02-03" "2016-02-04" "2016-02-05" "2016-02-06" "2016-02-07" "2016-02-08" "2016-02-09" "2016-02-10" "2016-02-11" "2016-02-12" "2016-02-13" "2016-02-14" "2016-02-15" "2016-02-16" "2016-02-17" "2016-02-18" "2016-02-19" "2016-02-20" "2016-02-21" "2016-02-22" "2016-02-23" "2016-02-24" "2016-02-25" "2016-02-26" "2016-02-27" "2016-02-28" "2016-02-29" }
  ?s golem:datePublished ?d .
}