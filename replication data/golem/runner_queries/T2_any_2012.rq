# T2_any_2012: F/F works with a tag of any label family in this year.
# Purpose: share of F/F works with any label (RQ1). Used in: Fig. 3.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?works) WHERE {
  ?s golem:romanticCategory "F/F" ; golem:datePublished ?d .
  FILTER(STRSTARTS(STR(?d), "2012"))
  ?s golem:keyword ?kw .
  BIND(LCASE(STR(?kw)) AS ?k)
  FILTER((CONTAINS(?k, "femslash")) || (CONTAINS(?k, "sapphic")) || (CONTAINS(?k, "lesbian")) || (REGEX(?k, "(^|[^a-z])wlw([^a-z]|$)") || CONTAINS(?k, "women loving women")) || (?k IN ("yuri", "yuri - freeform", "shoujo ai", "shoujo-ai", "shojo ai", "shoujo ai - freeform")) || (CONTAINS(?k, "百合") || CONTAINS(?k, "baihe")))
}