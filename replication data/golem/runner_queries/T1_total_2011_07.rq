# T1_total_2011_07: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2011-07-01" "2011-07-02" "2011-07-03" "2011-07-04" "2011-07-05" "2011-07-06" "2011-07-07" "2011-07-08" "2011-07-09" "2011-07-10" "2011-07-11" "2011-07-12" "2011-07-13" "2011-07-14" "2011-07-15" "2011-07-16" "2011-07-17" "2011-07-18" "2011-07-19" "2011-07-20" "2011-07-21" "2011-07-22" "2011-07-23" "2011-07-24" "2011-07-25" "2011-07-26" "2011-07-27" "2011-07-28" "2011-07-29" "2011-07-30" "2011-07-31" }
  ?s golem:datePublished ?d .
}