# T1_total_2012_12: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2012-12-01" "2012-12-02" "2012-12-03" "2012-12-04" "2012-12-05" "2012-12-06" "2012-12-07" "2012-12-08" "2012-12-09" "2012-12-10" "2012-12-11" "2012-12-12" "2012-12-13" "2012-12-14" "2012-12-15" "2012-12-16" "2012-12-17" "2012-12-18" "2012-12-19" "2012-12-20" "2012-12-21" "2012-12-22" "2012-12-23" "2012-12-24" "2012-12-25" "2012-12-26" "2012-12-27" "2012-12-28" "2012-12-29" "2012-12-30" "2012-12-31" }
  ?s golem:datePublished ?d .
}