# T1_total_2015_12: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2015-12-01" "2015-12-02" "2015-12-03" "2015-12-04" "2015-12-05" "2015-12-06" "2015-12-07" "2015-12-08" "2015-12-09" "2015-12-10" "2015-12-11" "2015-12-12" "2015-12-13" "2015-12-14" "2015-12-15" "2015-12-16" "2015-12-17" "2015-12-18" "2015-12-19" "2015-12-20" "2015-12-21" "2015-12-22" "2015-12-23" "2015-12-24" "2015-12-25" "2015-12-26" "2015-12-27" "2015-12-28" "2015-12-29" "2015-12-30" "2015-12-31" }
  ?s golem:datePublished ?d .
}