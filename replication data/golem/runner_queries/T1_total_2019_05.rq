# T1_total_2019_05: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2019-05-01" "2019-05-02" "2019-05-03" "2019-05-04" "2019-05-05" "2019-05-06" "2019-05-07" "2019-05-08" "2019-05-09" "2019-05-10" "2019-05-11" "2019-05-12" "2019-05-13" "2019-05-14" "2019-05-15" "2019-05-16" "2019-05-17" "2019-05-18" "2019-05-19" "2019-05-20" "2019-05-21" "2019-05-22" "2019-05-23" "2019-05-24" "2019-05-25" "2019-05-26" "2019-05-27" "2019-05-28" "2019-05-29" "2019-05-30" "2019-05-31" }
  ?s golem:datePublished ?d .
}