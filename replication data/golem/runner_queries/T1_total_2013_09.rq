# T1_total_2013_09: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2013-09-01" "2013-09-02" "2013-09-03" "2013-09-04" "2013-09-05" "2013-09-06" "2013-09-07" "2013-09-08" "2013-09-09" "2013-09-10" "2013-09-11" "2013-09-12" "2013-09-13" "2013-09-14" "2013-09-15" "2013-09-16" "2013-09-17" "2013-09-18" "2013-09-19" "2013-09-20" "2013-09-21" "2013-09-22" "2013-09-23" "2013-09-24" "2013-09-25" "2013-09-26" "2013-09-27" "2013-09-28" "2013-09-29" "2013-09-30" }
  ?s golem:datePublished ?d .
}