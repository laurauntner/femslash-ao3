# T1_total_2010_12: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2010-12-01" "2010-12-02" "2010-12-03" "2010-12-04" "2010-12-05" "2010-12-06" "2010-12-07" "2010-12-08" "2010-12-09" "2010-12-10" "2010-12-11" "2010-12-12" "2010-12-13" "2010-12-14" "2010-12-15" "2010-12-16" "2010-12-17" "2010-12-18" "2010-12-19" "2010-12-20" "2010-12-21" "2010-12-22" "2010-12-23" "2010-12-24" "2010-12-25" "2010-12-26" "2010-12-27" "2010-12-28" "2010-12-29" "2010-12-30" "2010-12-31" }
  ?s golem:datePublished ?d .
}