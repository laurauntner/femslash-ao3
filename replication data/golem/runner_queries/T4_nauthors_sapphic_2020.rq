# T4_nauthors_sapphic_2020: works and distinct (anonymised) authors of this family in this year.
# Purpose: concentration of a family in few authors (RQ2). Used in: concentration_2020_22.csv.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?works) (COUNT(DISTINCT ?x) AS ?distinct_author) WHERE {
  ?s golem:romanticCategory "F/F" ; golem:datePublished ?d .
  FILTER(STRSTARTS(STR(?d), "2020"))
  ?s golem:keyword ?kw .
  BIND(LCASE(STR(?kw)) AS ?k)
  FILTER(CONTAINS(?k, "sapphic"))
  OPTIONAL { ?s golem:author ?x }
}