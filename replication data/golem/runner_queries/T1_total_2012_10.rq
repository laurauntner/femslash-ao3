# T1_total_2012_10: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2012-10-01" "2012-10-02" "2012-10-03" "2012-10-04" "2012-10-05" "2012-10-06" "2012-10-07" "2012-10-08" "2012-10-09" "2012-10-10" "2012-10-11" "2012-10-12" "2012-10-13" "2012-10-14" "2012-10-15" "2012-10-16" "2012-10-17" "2012-10-18" "2012-10-19" "2012-10-20" "2012-10-21" "2012-10-22" "2012-10-23" "2012-10-24" "2012-10-25" "2012-10-26" "2012-10-27" "2012-10-28" "2012-10-29" "2012-10-30" "2012-10-31" }
  ?s golem:datePublished ?d .
}