# T1_total_2014_10: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2014-10-01" "2014-10-02" "2014-10-03" "2014-10-04" "2014-10-05" "2014-10-06" "2014-10-07" "2014-10-08" "2014-10-09" "2014-10-10" "2014-10-11" "2014-10-12" "2014-10-13" "2014-10-14" "2014-10-15" "2014-10-16" "2014-10-17" "2014-10-18" "2014-10-19" "2014-10-20" "2014-10-21" "2014-10-22" "2014-10-23" "2014-10-24" "2014-10-25" "2014-10-26" "2014-10-27" "2014-10-28" "2014-10-29" "2014-10-30" "2014-10-31" }
  ?s golem:datePublished ?d .
}