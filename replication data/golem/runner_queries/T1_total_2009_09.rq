# T1_total_2009_09: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2009-09-01" "2009-09-02" "2009-09-03" "2009-09-04" "2009-09-05" "2009-09-06" "2009-09-07" "2009-09-08" "2009-09-09" "2009-09-10" "2009-09-11" "2009-09-12" "2009-09-13" "2009-09-14" "2009-09-15" "2009-09-16" "2009-09-17" "2009-09-18" "2009-09-19" "2009-09-20" "2009-09-21" "2009-09-22" "2009-09-23" "2009-09-24" "2009-09-25" "2009-09-26" "2009-09-27" "2009-09-28" "2009-09-29" "2009-09-30" }
  ?s golem:datePublished ?d .
}