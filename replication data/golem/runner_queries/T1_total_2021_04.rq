# T1_total_2021_04: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2021-04-01" "2021-04-02" "2021-04-03" "2021-04-04" "2021-04-05" "2021-04-06" "2021-04-07" "2021-04-08" "2021-04-09" "2021-04-10" "2021-04-11" "2021-04-12" "2021-04-13" "2021-04-14" "2021-04-15" "2021-04-16" "2021-04-17" "2021-04-18" "2021-04-19" "2021-04-20" "2021-04-21" "2021-04-22" "2021-04-23" "2021-04-24" "2021-04-25" "2021-04-26" "2021-04-27" "2021-04-28" "2021-04-29" "2021-04-30" }
  ?s golem:datePublished ?d .
}