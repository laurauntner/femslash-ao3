# T1_total_2015_05: all works published in this month.
# Purpose: denominator of the F/F share; documents the 2022 cut-off. Used in: Fig. 2.
PREFIX golem: <https://golemlab.eu/graph/>
SELECT (COUNT(DISTINCT ?s) AS ?n) WHERE {
  VALUES ?d { "2015-05-01" "2015-05-02" "2015-05-03" "2015-05-04" "2015-05-05" "2015-05-06" "2015-05-07" "2015-05-08" "2015-05-09" "2015-05-10" "2015-05-11" "2015-05-12" "2015-05-13" "2015-05-14" "2015-05-15" "2015-05-16" "2015-05-17" "2015-05-18" "2015-05-19" "2015-05-20" "2015-05-21" "2015-05-22" "2015-05-23" "2015-05-24" "2015-05-25" "2015-05-26" "2015-05-27" "2015-05-28" "2015-05-29" "2015-05-30" "2015-05-31" }
  ?s golem:datePublished ?d .
}